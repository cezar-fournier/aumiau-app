AUMIAU_MONITOR_BASE_URL=https://aumiau.app.br
AUMIAU_BACKUP_ROOT=/var/backups/aumiau
AUMIAU_MONITOR_TIMEOUT_SECONDS=10
AUMIAU_MAX_BACKUP_AGE_HOURS=30
AUMIAU_MAX_DISK_PERCENT=85
AUMIAU_MONITOR_CONTAINERS=backend-api-1,backend-db-1,backend-caddy-1,aumiau-mailserver
# Opcional: endpoint privado que aceite JSON para entrega dos alertas.
AUMIAU_ALERT_WEBHOOK_URL=
# URL secreta do heartbeat do Better Stack. Nunca versionar o valor real.
AUMIAU_HEARTBEAT_URL=
