[Unit]
Description=Notifica falha do teste de restauração AuMiau ao Better Stack
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/aumiau/restore-heartbeat.env
ExecStart=/usr/local/sbin/aumiau-heartbeat-notify fail restore-test
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
